{
	"name": "@repo/ui",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "bun --env-file=../../.env --env-file=../../.env.local --bun vite build",
		"check": "bun --env-file=../../.env --env-file=../../.env.local svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"dev": "bun --env-file=../../.env --env-file=../../.env.local --bun vite",
		"preview": "bun --env-file=../../.env --env-file=../../.env.local --bun vite preview"
	},
	"dependencies": {
		"@fontsource-variable/google-sans-code": "^5.2.4",
		"@fontsource-variable/google-sans-flex": "^5.2.3",
		"@orpc/client": "^1.14.3",
		"@orpc/tanstack-query": "^1.14.3",
		"@repo/shared": "workspace:*",
		"@sveltejs/adapter-static": "^3.0.9",
		"@sveltejs/kit": "^2.48.4",
		"@tanstack/svelte-query": "^6.1.33",
		"svelte": "^5.41.3",
		"vite": "^7.1.12"
	},
	"devDependencies": {
		"@orpc/server": "^1.14.3",
		"@repo/server": "workspace:*",
		"@tailwindcss/vite": "^4.3.0",
		"svelte-check": "^4.3.3",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3"
	}
