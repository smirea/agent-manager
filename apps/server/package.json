{
	"name": "@repo/server",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./rpc": "./src/rpc.ts",
		"./package.json": "./package.json"
	},
	"scripts": {
		"dev": "bun --env-file=../../.env --env-file=../../.env.local --watch src/index.ts",
		"start": "bun --env-file=../../.env --env-file=../../.env.local src/index.ts",
		"typecheck": "tsc --noEmit -p tsconfig.json"
	},
	"dependencies": {
		"@agentclientprotocol/sdk": "^0.22.1",
		"@orpc/server": "^1.14.3",
		"@repo/shared": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14"
	}
}
